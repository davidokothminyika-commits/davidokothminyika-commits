# Copy this file to .env for local development. Never commit .env.
#
# PROFILE_GITHUB_TOKEN must be a read-only token that can see the repositories
# you want counted. For classic tokens, the minimum is the `read:user` and
# `repo` scopes. For fine-grained tokens, grant:
#   - User permissions: read access to profile data and email addresses (optional)
#   - Repository permissions: read-only access to Metadata and Contents for
#     every repository that should participate in the statistics.
#
# The token is never written to disk and must never be logged.
PROFILE_GITHUB_TOKEN=

# Log level: debug | info | warn | error
LOG_LEVEL=info

# When true, generate into build/ without modifying tracked files.
DRY_RUN=false
