{
  "theme": {
    "name": "midnight",
    "colors": {
      "background": "#070B16",
      "surface": "#0D1526",
      "surfaceAlt": "#111C31",
      "navy": "#0A1930",
      "cyan": "#22D3EE",
      "violet": "#A78BFA",
      "green": "#34D399",
      "text": "#E2E8F0",
      "muted": "#94A3B8",
      "border": "#1E293B"
    }
  },
  "layout": {
    "maxWidth": 1000,
    "languageChart": {
      "width": 860,
      "height": 260,
      "maxLanguages": 8,
      "showLegend": true
    },
    "statistics": {
      "columns": 4
    },
    "featuredRepositories": {
      "limit": 4
    },
    "recentActivity": {
      "limit": 5
    }
  },
  "assets": {
    "banner": "assets/generated/banner.svg",
    "languageChart": "assets/generated/languages.svg",
    "threeDimensional": {
      "generatorOutputDirectory": "profile-3d-contrib",
      "targets": [
        {
          "variant": "midnight",
          "source": "profile-3d-contrib.svg",
          "target": "assets/3d/profile-3d-contrib.svg"
        },
        {
          "variant": "night",
          "source": "profile-3d-contrib-night.svg",
          "target": "assets/3d/profile-3d-contrib-night.svg"
        },
        {
          "variant": "purple",
          "source": "profile-3d-contrib-purple.svg",
          "target": "assets/3d/profile-3d-contrib-purple.svg"
        }
      ]
    }
  },
  "output": {
    "readme": "README.md",
    "stagingDirectory": "build"
  },
  "sections": {
    "hero": true,
    "about": true,
    "languages": true,
    "technology": true,
    "statistics": true,
    "threeDimensionalGraph": true,
    "languageChart": true,
    "featuredRepositories": true,
    "currentlyWorkingOn": true,
    "recentActivity": true,
    "socials": true,
    "updatedAt": true
  },
  "timestamp": {
    "label": "Last updated",
    "locale": "en-GB",
    "timeZone": "Africa/Nairobi"
  }
}
